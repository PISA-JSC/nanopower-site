---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Pagination from '../../components/Pagination.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { url, categoryLabels } from '../../utils/url';
import { getCollection } from 'astro:content';

const POSTS_PER_PAGE = 9;

const allPosts = (await getCollection('posts', p => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
const currentPage = 1;
const posts = allPosts.slice(0, POSTS_PER_PAGE);

const categories = ['tin-cong-ty', 'kien-thuc', 'san-pham', 'tuyen-dung'] as const;
---

<Base
  title="Tin tức & Kiến thức"
  description="Cập nhật tin tức công ty và kiến thức chuyên sâu về tự động hóa, IoT, điện và xử lý nước từ Nano Power."
>
  <div class="bg-brand-50 border-b border-brand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <Breadcrumb items={[
        { label: 'Trang chủ', href: url('/') },
        { label: 'Tin tức' },
      ]} />
    </div>
  </div>

  <section class="bg-brand-800 text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold mb-4">Tin tức & Kiến thức</h1>
      <p class="text-brand-100 text-xl leading-relaxed">
        Chia sẻ kiến thức chuyên môn và cập nhật xu hướng công nghệ từ đội ngũ Nano Power.
      </p>
    </div>
  </section>

  <!-- Category filter -->
  <div class="border-b border-gray-200 bg-white sticky top-[80px] z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-1 overflow-x-auto scrollbar-none py-3">
        <a
          href={url('/tin-tuc')}
          class="shrink-0 px-4 py-2 rounded-lg text-sm font-medium bg-brand-700 text-white"
        >
          Tất cả
        </a>
        {categories.map(cat => (
          <a
            href={url(`/tin-tuc?category=${cat}`)}
            class="shrink-0 px-4 py-2 rounded-lg text-sm font-medium text-ink hover:bg-brand-50 hover:text-brand-700 transition-colors border border-gray-200"
          >
            {categoryLabels[cat]}
          </a>
        ))}
      </div>
    </div>
  </div>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {posts.length > 0 ? (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {posts.map(post => (
              <PostCard post={post} />
            ))}
          </div>
          <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/tin-tuc" />
        </>
      ) : (
        <div class="text-center py-20 text-muted">
          <p class="text-xl">Chưa có bài viết nào.</p>
        </div>
      )}
    </div>
  </section>

  <!-- RSS link -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <a
      href={url('/tin-tuc/rss.xml')}
      class="inline-flex items-center gap-2 text-muted text-sm hover:text-brand-700 transition-colors"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
      </svg>
      Đăng ký RSS feed
    </a>
  </div>
</Base>
