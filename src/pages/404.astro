---
import Base from '../layouts/Base.astro';
import { url } from '../utils/url';
---

<Base
  title="404 — Trang không tồn tại"
  description="Trang bạn đang tìm kiếm không tồn tại hoặc đã được di chuyển."
>
  <section class="min-h-[70vh] flex items-center justify-center bg-white">
    <div class="max-w-lg mx-auto px-4 text-center">
      <!-- Hexagon 404 graphic -->
      <div class="relative inline-flex items-center justify-center mb-8">
        <svg width="200" height="174" viewBox="0 0 200 174" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="100,2 198,52 198,150 100,200 2,150 2,52"
            fill="#F0FBF0" stroke="#29C22C" stroke-width="2"/>
          <text x="100" y="100" text-anchor="middle" dominant-baseline="middle"
            font-family="Georgia, serif" font-size="48" font-weight="700" fill="#18751A">
            404
          </text>
        </svg>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-ink mb-4">
        Trang không tồn tại
      </h1>
      <p class="text-muted text-lg leading-relaxed mb-8">
        Xin lỗi, trang bạn đang tìm kiếm đã được di chuyển hoặc không tồn tại.
        Hãy kiểm tra lại đường dẫn hoặc quay về trang chủ.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={url('/')}
          class="inline-flex items-center justify-center gap-2 text-[#04121f] font-bold" style="background: linear-gradient(120deg,#1668e3,#00d4ff);" class=" px-8 py-4 rounded-lg transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          Về trang chủ
        </a>
        <a
          href={url('/lien-he')}
          class="inline-flex items-center justify-center gap-2 border-2 font-semibold" style="border-color:#1668e3; color:#1668e3;" onmouseover="this.style.background='#1668e3';this.style.color='#04121f';" onmouseout="this.style.background='';this.style.color='#1668e3'" class=" px-8 py-4 rounded-lg transition-colors"
        >
          Liên hệ hỗ trợ
        </a>
      </div>
    </div>
  </section>
</Base>
