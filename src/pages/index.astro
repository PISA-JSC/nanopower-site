---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SolutionCard from '../components/SolutionCard.astro';
import PostCard from '../components/PostCard.astro';
import StatsBand from '../components/StatsBand.astro';
import CTABand from '../components/CTABand.astro';
import { url } from '../utils/url';
import { loadYaml, type HomeData } from '../utils/data';
import { getCollection } from 'astro:content';

const home = loadYaml<HomeData>('home.yml');

const solutions = (await getCollection('solutions', s => !s.data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const featuredPosts = (await getCollection('posts', p => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Nano Power">
  <!-- ① Hero (dark canvas) -->
  <Hero />

  <!-- ② Stats -->
  <StatsBand />

  <!-- Technology partners strip -->
  <div class="border-b border-slate-100 bg-slate-50/50 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        <span class="text-slate-400 text-xs font-medium uppercase tracking-widest shrink-0">Công nghệ đối tác</span>
        {['Siemens', 'Mitsubishi', 'Omron', 'Schneider', 'Delta', 'LoRaWAN'].map(brand => (
          <span class="text-slate-400 text-sm font-semibold hover:text-slate-600 transition-colors cursor-default select-none tracking-tight">
            {brand}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ③ Solutions (white) -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <SectionHeading
          label="Năng lực cốt lõi"
          title="Giải pháp chúng tôi cung cấp"
        />
        <a
          href={url('/giai-phap')}
          class="shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-600 transition-colors pb-1"
        >
          Xem tất cả giải pháp
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {solutions.map(solution => (
          <SolutionCard solution={solution} />
        ))}
      </div>
    </div>
  </section>

  <!-- ④ Why Us (slate-50) — list layout, not 4-card grid -->
  <section class="py-24 lg:py-32 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1fr_1fr] gap-16 items-start">

        <!-- Left: heading block -->
        <div>
          <SectionHeading
            label="Tại sao chọn chúng tôi"
            title="Cam kết từ đội ngũ kỹ thuật"
            subtitle="Chúng tôi không chỉ cung cấp thiết bị hay phần mềm — chúng tôi giải quyết bài toán vận hành thực tế của doanh nghiệp bạn."
          />
          <a
            href={url('/gioi-thieu')}
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-600 transition-colors"
          >
            Tìm hiểu về chúng tôi
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

        <!-- Right: feature list — SVG icons, no emoji -->
        <div class="flex flex-col gap-8">
          {home.why_us.map((item, i) => {
            const whyIcons = [
              /* kỹ thuật */ `<path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2v-4M9 21H5a2 2 0 0 1-2-2v-4m0 0h18"/>`,
              /* tích hợp */ `<path stroke-linecap="round" stroke-linejoin="round" d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path stroke-linecap="round" stroke-linejoin="round" d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>`,
              /* chất lượng */ `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0 1 12 2.944a11.955 11.955 0 0 1-8.618 3.04A12.02 12.02 0 0 0 3 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
              /* hỗ trợ */   `<path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 1 1-8 0 4 4 0 0 1 8 0zM3 20a6 6 0 0 1 12 0v1H3v-1z"/>`,
            ];
            return (
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-100/60 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" set:html={whyIcons[i % 4]}/>
                </div>
                <div>
                  <h3 class="font-semibold text-[0.9375rem] text-ink mb-1">{item.title}</h3>
                  <p class="text-slate-500 text-sm leading-relaxed">{item.description}</p>
                </div>
              </div>
            );
          })}
        </div>

      </div>
    </div>
  </section>

  <!-- ⑤ Latest posts (white) -->
  {featuredPosts.length > 0 && (
    <section class="py-24 lg:py-32 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
          <SectionHeading
            label="Kiến thức & tin tức"
            title="Cập nhật mới nhất"
          />
          <a
            href={url('/tin-tuc')}
            class="shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-600 transition-colors pb-1"
          >
            Xem tất cả bài viết
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {featuredPosts.map(post => (
            <PostCard post={post} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ⑥ CTA (dark canvas) -->
  <CTABand />
</Base>
