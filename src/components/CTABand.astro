---
import { url } from '../utils/url';

interface Props {
  title?: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = 'Sẵn sàng tối ưu hóa doanh nghiệp của bạn?',
  subtitle = 'Đội ngũ kỹ sư Nano Power luôn sẵn sàng tư vấn giải pháp phù hợp nhất cho nhu cầu của bạn.',
  primaryLabel = 'Liên hệ tư vấn',
  primaryHref = '/lien-he',
  secondaryLabel = 'Xem dự án',
  secondaryHref = '/du-an',
} = Astro.props;
---

<section class="relative bg-canvas overflow-hidden py-24">
  <!-- Very subtle hex pattern in background -->
  <div class="absolute inset-0 pointer-events-none select-none" style="opacity:0.04" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="cta-hex" x="0" y="0" width="60" height="52" patternUnits="userSpaceOnUse">
          <polygon points="30,2 58,16 58,44 30,58 2,44 2,16" fill="none" stroke="white" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#cta-hex)"/>
    </svg>
  </div>
  <!-- Green glow left -->
  <div class="absolute -left-32 top-1/2 -translate-y-1/2 w-80 h-80 bg-brand-700/25 rounded-full blur-[80px] pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-[-0.03em] leading-tight mb-5">
      {title}
    </h2>
    <p class="text-slate-400 text-lg leading-relaxed mb-10">
      {subtitle}
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={url(primaryHref)}
        class="inline-flex items-center justify-center gap-2 bg-brand-700 hover:bg-brand-600 active:scale-[0.98] text-white font-semibold px-7 py-3.5 rounded-xl transition-all duration-150 text-sm"
      >
        {primaryLabel}
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <a
        href={url(secondaryHref)}
        class="inline-flex items-center justify-center gap-2 bg-white/[0.06] hover:bg-white/[0.10] border border-white/[0.12] text-white font-medium px-7 py-3.5 rounded-xl transition-colors duration-150 text-sm"
      >
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>
