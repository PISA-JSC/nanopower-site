---
import { url } from '../utils/url';

interface Props {
  title?: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = 'Sẵn sàng tối ưu hóa doanh nghiệp của bạn?',
  subtitle = 'Đội ngũ kỹ sư Nano Power luôn sẵn sàng tư vấn giải pháp phù hợp nhất với nhu cầu và quy mô của bạn.',
  primaryLabel = 'Liên hệ tư vấn',
  primaryHref = '/lien-he',
  secondaryLabel = 'Xem dự án',
  secondaryHref = '/du-an',
} = Astro.props;
---

<section class="bg-canvas py-24">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
      {title}
    </h2>
    <p class="text-slate-400 text-lg leading-relaxed mb-10">
      {subtitle}
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={url(primaryHref)}
        class="inline-flex items-center justify-center gap-2 bg-brand-700 hover:bg-brand-600 active:bg-brand-800 text-white font-semibold px-7 py-3.5 rounded-xl transition-colors duration-150 text-sm"
      >
        {primaryLabel}
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <a
        href={url(secondaryHref)}
        class="inline-flex items-center justify-center gap-2 bg-white/[0.07] hover:bg-white/[0.12] border border-white/20 text-white font-medium px-7 py-3.5 rounded-xl transition-colors duration-150 text-sm"
      >
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>
