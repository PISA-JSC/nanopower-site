---
import { url } from '../utils/url';
import { loadYaml, type SiteData } from '../utils/data';

const site = loadYaml<SiteData>('site.yml');

const navLinks = [
  { label: 'Giới thiệu', href: url('/gioi-thieu') },
  { label: 'Giải pháp',  href: url('/giai-phap') },
  { label: 'Dự án',      href: url('/du-an') },
  { label: 'Tin tức',    href: url('/tin-tuc') },
  { label: 'Tuyển dụng', href: url('/tuyen-dung') },
];

const currentPath = Astro.url.pathname;
---

<!-- ── Fixed transparent → dark-blur header ──────────────────── -->
<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
  style="padding: 16px 0;"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">

      <!-- Logo -->
      <a href={url('/')} class="flex items-center gap-3 shrink-0 group" aria-label="Nano Power — Trang chủ">
        <img
          src={url('/logo.png')}
          alt="Nano Power"
          class="h-9 w-9 object-contain"
          width="36"
          height="36"
        />
        <div>
          <strong class="block text-[1.05rem] font-extrabold tracking-wide text-white leading-tight">Nano Power</strong>
          <span class="block text-[0.6rem] tracking-[0.22em] uppercase text-[#5ce6ff] font-semibold">Automation · Software · IoT</span>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Điều hướng chính">
        {navLinks.map(link => {
          const active = currentPath.startsWith(link.href.replace(/\/$/, ''));
          return (
            <a
              href={link.href}
              class={`text-sm font-medium relative pb-1.5 transition-colors duration-200 nav-link ${
                active ? 'text-white nav-link-active' : 'text-white/80 hover:text-white'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- CTA + hamburger -->
      <div class="flex items-center gap-3">
        <a
          href={url('/lien-he')}
          class="hidden sm:inline-flex items-center gap-2 btn btn-primary text-sm px-5 py-2.5"
          style="padding: 10px 22px; font-size: 0.9rem;"
        >
          Nhận tư vấn
        </a>

        <button
          id="mobile-menu-btn"
          class="md:hidden w-11 h-11 flex items-center justify-center rounded-xl text-white"
          style="border: 1px solid rgba(255,255,255,0.18);"
          aria-label="Mở menu điều hướng"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -4px;
    width: 0; height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #1668e3, #00d4ff);
    transition: width 0.3s cubic-bezier(0.22,1,0.36,1);
  }
  .nav-link:hover::after,
  .nav-link-active::after { width: 100%; }
</style>

<!-- ── Full-screen mobile overlay ───────────────────────────── -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden flex-col"
  style="background: rgba(5,13,28,0.97); backdrop-filter: blur(14px);"
  role="dialog"
  aria-modal="true"
  aria-label="Menu điều hướng"
>
  <!-- Top bar -->
  <div class="flex items-center justify-between px-4 h-16" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
    <a href={url('/')} class="flex items-center gap-2.5" aria-label="Nano Power">
      <div class="w-9 h-9 rounded-xl flex items-center justify-center font-black text-base"
           style="background: linear-gradient(135deg,#1668e3,#00d4ff); color:#04121f;">
        <img src={url('/logo.png')} alt="" class="h-7 w-7 object-contain brightness-0 invert" width="28" height="28" />
      </div>
      <span class="font-bold text-[1.0625rem] text-white">Nano Power</span>
    </a>
    <button
      id="mobile-close-btn"
      class="w-10 h-10 flex items-center justify-center rounded-xl text-white/70 hover:text-white transition-colors"
      style="border: 1px solid rgba(255,255,255,0.12);"
      aria-label="Đóng menu"
    >
      aria-label="Đóng menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Nav links -->
  <nav class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-0.5">
    {navLinks.map(link => (
      <a
        href={link.href}
        class="flex items-center h-14 px-4 rounded-xl text-base font-medium text-white/80 hover:text-white transition-colors"
        style="border: 1px solid transparent;"
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Bottom CTA -->
  <div class="px-4 pb-10 pt-4" style="border-top: 1px solid rgba(255,255,255,0.08);">
    <a
      href={url('/lien-he')}
      class="btn btn-primary flex items-center justify-center w-full text-base"
      style="border-radius: 14px; height: 56px;"
    >
      Liên hệ ngay
    </a>
  </div>
</div>

<script>
  const headerEl  = document.getElementById('site-header')!;
  const menuEl    = document.getElementById('mobile-menu')!;
  const openBtn   = document.getElementById('mobile-menu-btn')!;
  const closeBtn  = document.getElementById('mobile-close-btn')!;

  const openMenu = () => {
    menuEl.classList.remove('hidden');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  };

  const closeMenu = () => {
    menuEl.classList.add('hidden');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    openBtn.focus();
  };

  openBtn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !menuEl.classList.contains('hidden')) closeMenu();
  });

  // Dark blur when page scrolls
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 20;
    headerEl.style.background = scrolled ? 'rgba(6,15,30,0.92)' : 'transparent';
    headerEl.style.backdropFilter = scrolled ? 'blur(14px)' : 'none';
    headerEl.style.boxShadow = scrolled ? '0 10px 34px -18px rgba(0,0,0,0.8)' : 'none';
    headerEl.style.borderBottom = scrolled ? '1px solid rgba(255,255,255,0.07)' : 'none';
    headerEl.style.padding = scrolled ? '10px 0' : '16px 0';
  }, { passive: true });
</script>
