---
import { loadYaml, type HomeData } from '../utils/data';
const home = loadYaml<HomeData>('home.yml');
const { stats } = home;
---

<section class="py-6 bg-white" style="margin-top: -68px; position: relative; z-index: 5;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-[22px] overflow-hidden" style="background: #fff; border: 1px solid rgba(11,18,32,0.08); box-shadow: 0 30px 70px -30px rgba(6,22,51,0.55); display: grid; grid-template-columns: repeat(4, 1fr);">
      {stats.slice(0, 4).map((stat, i) => (
        <div class="text-center" style={`padding: 32px 22px; ${i < 3 ? 'border-right: 1px solid rgba(11,18,32,0.08);' : ''}`}>
          <div class="flex items-baseline justify-center gap-0.5 mb-1.5">
            <span
              class="font-extrabold leading-none tabular-nums counter"
              style="font-size: clamp(1.7rem, 3.4vw, 2.3rem); letter-spacing: -0.03em; background: linear-gradient(115deg, #1668e3, #00d4ff); -webkit-background-clip: text; background-clip: text; color: transparent;"
              data-target={stat.value}
              data-index={i}
            >
              {stat.value}
            </span>
            <span class="text-xl font-bold" style="background: linear-gradient(115deg, #1668e3, #00d4ff); -webkit-background-clip: text; background-clip: text; color: transparent;">{stat.suffix}</span>
          </div>
          <p class="text-sm font-semibold" style="color: #475569; margin-top: 4px;">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const counters = document.querySelectorAll<HTMLElement>('.counter');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReduced) {
    counters.forEach(el => { el.textContent = el.dataset.target ?? '0'; });
  } else {
    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target ?? '0', 10);
      if (target === 0) return;
      const duration = 1400;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const ease = 1 - Math.pow(1 - t, 3);
        el.textContent = Math.floor(ease * target).toString();
        if (t < 1) requestAnimationFrame(step);
        else el.textContent = target.toString();
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { animate(e.target as HTMLElement); io.unobserve(e.target); }
      }),
      { threshold: 0.4 }
    );
    counters.forEach(c => io.observe(c));
  }
</script>
