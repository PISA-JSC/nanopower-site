---
import { loadYaml, type HomeData } from '../utils/data';
const home = loadYaml<HomeData>('home.yml');
const { stats } = home;
---

<section class="border-y border-slate-100 py-14 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-y-10 gap-x-4 text-center">
      {stats.map((stat, i) => (
        <div>
          <div class="flex items-baseline justify-center gap-0.5 mb-1.5">
            <span
              class="text-[2.5rem] font-bold text-ink leading-none tabular-nums counter"
              data-target={stat.value}
              data-index={i}
            >
              {stat.value}
            </span>
            <span class="text-xl font-semibold text-brand-700">{stat.suffix}</span>
          </div>
          <p class="text-slate-500 text-sm">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const counters = document.querySelectorAll<HTMLElement>('.counter');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReduced) {
    counters.forEach(el => { el.textContent = el.dataset.target ?? '0'; });
  } else {
    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target ?? '0', 10);
      if (target === 0) return;
      const duration = 1400;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const ease = 1 - Math.pow(1 - t, 3);
        el.textContent = Math.floor(ease * target).toString();
        if (t < 1) requestAnimationFrame(step);
        else el.textContent = target.toString();
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { animate(e.target as HTMLElement); io.unobserve(e.target); }
      }),
      { threshold: 0.4 }
    );
    counters.forEach(c => io.observe(c));
  }
</script>
