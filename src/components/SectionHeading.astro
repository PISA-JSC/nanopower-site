---
interface Props {
  label?: string;    /* small all-caps category above heading */
  title: string;
  subtitle?: string;
  center?: boolean;
  light?: boolean;
}
const { label, title, subtitle, center = false, light = false } = Astro.props;
---

<div class={`mb-14 ${center ? 'text-center' : ''}`}>
  {label && (
    <p class={`text-xs font-semibold uppercase tracking-[0.12em] mb-4 ${light ? 'text-brand-400' : 'text-brand-700'}`}>
      {label}
    </p>
  )}
  <h2 class={`text-4xl lg:text-[2.75rem] font-bold tracking-[-0.03em] leading-[1.1] ${light ? 'text-white' : 'text-ink'}`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`mt-5 text-lg leading-relaxed ${center ? 'max-w-2xl mx-auto' : 'max-w-xl'} ${light ? 'text-slate-400' : 'text-slate-500'}`}>
      {subtitle}
    </p>
  )}
</div>
