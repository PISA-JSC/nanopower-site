---
interface Props {
  title: string;
  subtitle?: string;
  center?: boolean;
  light?: boolean;
}

const { title, subtitle, center = false, light = false } = Astro.props;
---

<div class={`mb-12 ${center ? 'text-center' : ''}`}>
  <h2 class={`font-serif text-3xl sm:text-4xl font-bold mb-4 ${light ? 'text-white' : 'text-ink'}`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`text-lg leading-relaxed max-w-2xl ${center ? 'mx-auto' : ''} ${light ? 'text-brand-100' : 'text-muted'}`}>
      {subtitle}
    </p>
  )}
  <div class={`mt-4 h-1 w-16 bg-brand-500 rounded-full ${center ? 'mx-auto' : ''}`}></div>
</div>
