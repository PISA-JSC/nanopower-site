---
interface Props {
  label?: string;    /* small all-caps category above heading */
  title: string;
  subtitle?: string;
  center?: boolean;
  light?: boolean;
}
const { label, title, subtitle, center = false, light = false } = Astro.props;
---

<div class={`mb-14 ${center ? 'text-center' : ''}`}>
  {label && (
    <span class={`eyebrow${light ? ' light' : ''}${center ? ' justify-center' : ''}`} style={center ? 'display: inline-flex;' : ''}>
      {label}
    </span>
  )}
  <h2 class={`font-extrabold tracking-[-0.02em] leading-[1.18] ${light ? 'text-white' : 'text-ink'}`}
      style="font-size: clamp(1.75rem, 3.6vw, 2.7rem); font-weight: 800;">
    {title}
  </h2>
  {subtitle && (
    <p class={`mt-4 leading-relaxed ${center ? 'max-w-2xl mx-auto' : 'max-w-xl'}`}
       style={`font-size: 1.05rem; color: ${light ? 'rgba(220,235,255,0.7)' : '#475569'};`}>
      {subtitle}
    </p>
  )}
</div>
