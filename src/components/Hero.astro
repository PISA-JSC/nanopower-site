---
import { url } from '../utils/url';
import { loadYaml, type HomeData } from '../utils/data';

const home = loadYaml<HomeData>('home.yml');
const { title, subtitle, cta_label, cta_url, secondary_cta_label, secondary_cta_url } = home.hero;
const { stats } = home;
---

<section class="relative bg-canvas text-white overflow-hidden">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="grid lg:grid-cols-[1fr_460px] xl:grid-cols-[1fr_500px] gap-10 xl:gap-16 items-center">

      <!-- ── Left: content ───────────────────────────────────── -->
      <div class="relative z-10">
        <p class="text-brand-500 text-[0.6875rem] font-bold uppercase tracking-[0.18em] mb-6">
          Tự động hóa · Phần mềm · IoT
        </p>

        <h1 class="text-[3rem] sm:text-[3.75rem] lg:text-[4.25rem] xl:text-[4.75rem] font-bold text-white leading-[1.02] tracking-[-0.04em] mb-6">
          {title}
        </h1>

        <p class="text-slate-400 text-lg leading-relaxed mb-10 max-w-lg">
          {subtitle}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 mb-12">
          <a
            href={url(cta_url)}
            class="inline-flex items-center justify-center gap-2 bg-brand-700 hover:bg-brand-600 active:scale-[0.98] text-white font-semibold px-7 py-3.5 rounded-xl transition-all duration-150 text-sm"
          >
            {cta_label}
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a
            href={url(secondary_cta_url)}
            class="inline-flex items-center justify-center gap-2 bg-white/[0.06] hover:bg-white/[0.10] border border-white/[0.12] text-white font-medium px-7 py-3.5 rounded-xl transition-colors duration-150 text-sm"
          >
            {secondary_cta_label}
          </a>
        </div>

        <!-- Trust bar — 3 stats inline -->
        <div class="flex flex-wrap items-center gap-x-8 gap-y-3 pt-8 border-t border-white/[0.08]">
          {stats.slice(0, 3).map(s => (
            <div>
              <span class="font-bold text-white text-xl">{s.value}{s.suffix} </span>
              <span class="text-slate-500 text-sm">{s.label.toLowerCase()}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- ── Right: real factory photo ──────────────────────── -->
      <div class="hidden lg:block relative">
        <!-- Photo frame with subtle green glow ring -->
        <div class="relative rounded-[1.25rem] overflow-hidden aspect-[4/3] shadow-[0_0_80px_rgba(41,194,44,0.15)] ring-1 ring-white/10">
          <img
            src={url('/images/hero-banner-tu-dong-hoa.jpg')}
            alt="Hệ thống tự động hóa nhà máy hiện đại"
            class="w-full h-full object-cover"
            width="900"
            height="675"
            loading="eager"
            fetchpriority="high"
          />
          <!-- Bottom gradient for chip readability -->
          <div class="absolute inset-0 bg-gradient-to-t from-canvas/55 via-canvas/10 to-transparent pointer-events-none"></div>

          <!-- Metric chip — top right -->
          <div class="absolute top-4 right-4 bg-canvas/75 backdrop-blur-md border border-white/10 rounded-xl px-4 py-3 text-center min-w-[88px]">
            <div class="text-[1.5rem] font-bold text-white leading-none tabular-nums">
              {stats[1]?.value}<span class="text-brand-500 text-lg">{stats[1]?.suffix}</span>
            </div>
            <div class="text-[0.625rem] text-slate-400 mt-1 font-medium tracking-wide uppercase">{stats[1]?.label}</div>
          </div>

          <!-- Metric chip — bottom left -->
          <div class="absolute bottom-4 left-4 bg-canvas/75 backdrop-blur-md border border-white/10 rounded-xl px-4 py-3 text-center min-w-[100px]">
            <div class="text-[1.5rem] font-bold text-white leading-none tabular-nums">
              {stats[5]?.value}<span class="text-brand-500 text-lg">{stats[5]?.suffix}</span>
            </div>
            <div class="text-[0.625rem] text-slate-400 mt-1 font-medium tracking-wide uppercase">{stats[5]?.label}</div>
          </div>

          <!-- Online indicator — bottom right -->
          <div class="absolute bottom-4 right-4 bg-canvas/75 backdrop-blur-md border border-white/10 rounded-lg px-3 py-2 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse shrink-0"></span>
            <span class="text-[0.6875rem] text-slate-300 font-medium">Hệ thống trực tuyến</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
