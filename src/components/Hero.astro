---
import { url } from '../utils/url';
import { loadYaml, type HomeData } from '../utils/data';

const home = loadYaml<HomeData>('home.yml');
const { title, subtitle, cta_label, cta_url, secondary_cta_label, secondary_cta_url } = home.hero;
---

<section class="relative bg-canvas text-white overflow-hidden">
  <!-- Hex grid — very faint, 4 % opacity -->
  <div class="absolute inset-0 pointer-events-none select-none" style="opacity:0.04" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-hex" x="0" y="0" width="80" height="69.28" patternUnits="userSpaceOnUse">
          <polygon points="40,2 78,22 78,56 40,76 2,56 2,22" fill="none" stroke="white" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-hex)"/>
    </svg>
  </div>

  <!-- Single green glow — bottom-right corner only -->
  <div class="absolute -bottom-32 -right-32 w-[500px] h-[500px] bg-brand-700/20 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 lg:py-40">
    <div class="max-w-3xl">
      <!-- Pill badge -->
      <div class="inline-flex items-center gap-2 bg-white/[0.07] border border-white/[0.12] rounded-full px-4 py-1.5 mb-8">
        <span class="w-2 h-2 bg-brand-500 rounded-full" aria-hidden="true"></span>
        <span class="text-slate-300 text-sm font-medium tracking-wide">Tự động hóa · Phần mềm · IoT</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-bold leading-[1.1] tracking-tight text-white mb-6">
        {title}
      </h1>

      <p class="text-slate-300 text-lg sm:text-xl leading-relaxed mb-10 max-w-2xl">
        {subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href={url(cta_url)}
          class="inline-flex items-center justify-center gap-2 bg-brand-700 hover:bg-brand-600 active:bg-brand-800 text-white font-semibold px-7 py-3.5 rounded-xl transition-colors duration-150 text-sm focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          {cta_label}
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a
          href={url(secondary_cta_url)}
          class="inline-flex items-center justify-center gap-2 bg-white/[0.07] hover:bg-white/[0.12] border border-white/20 text-white font-medium px-7 py-3.5 rounded-xl transition-colors duration-150 text-sm"
        >
          {secondary_cta_label}
        </a>
      </div>
    </div>
  </div>
</section>
