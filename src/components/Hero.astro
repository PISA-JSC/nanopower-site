---
import { url } from '../utils/url';
import { loadYaml, type HomeData } from '../utils/data';

const home = loadYaml<HomeData>('home.yml');
const { title, subtitle, cta_label, cta_url, secondary_cta_label, secondary_cta_url } = home.hero;
---

<section class="relative bg-brand-900 text-white overflow-hidden">
  <!-- Hexagonal decorative pattern -->
  <div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-hex" x="0" y="0" width="80" height="69.28" patternUnits="userSpaceOnUse">
          <polygon points="40,1 79,21 79,61 40,81 1,61 1,21"
            fill="none" stroke="white" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-hex)"/>
    </svg>
  </div>

  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-brand-900 via-brand-800/80 to-brand-700/60 pointer-events-none" aria-hidden="true"></div>

  <!-- Accent circle -->
  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-96 h-96 bg-brand-500/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 lg:py-40">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 bg-brand-500/20 border border-brand-400/30 rounded-full px-4 py-1.5 mb-6">
        <span class="w-2 h-2 bg-brand-400 rounded-full animate-pulse"></span>
        <span class="text-brand-200 text-sm font-medium">Tự động hóa • Công nghệ • Chuyển đổi số</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
        {title}
      </h1>

      <p class="text-brand-100 text-lg sm:text-xl leading-relaxed mb-10 max-w-2xl">
        {subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={url(cta_url)}
          class="inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-white font-semibold px-8 py-4 rounded-lg transition-colors text-base"
        >
          {cta_label}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a
          href={url(secondary_cta_url)}
          class="inline-flex items-center justify-center gap-2 border-2 border-white/30 hover:border-white/60 hover:bg-white/10 text-white font-semibold px-8 py-4 rounded-lg transition-colors text-base"
        >
          {secondary_cta_label}
        </a>
      </div>
    </div>
  </div>
</section>
