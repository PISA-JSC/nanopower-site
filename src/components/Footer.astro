---
import { url } from '../utils/url';
import { loadYaml, type SiteData } from '../utils/data';

const site = loadYaml<SiteData>('site.yml');
---

<footer class="bg-brand-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Col 1: Brand -->
      <div class="lg:col-span-1">
        <a href={url('/')} class="flex items-center gap-3 mb-4">
          <img
            src={url('/favicon.svg')}
            alt="Nano Power"
            class="h-10 w-10 object-contain brightness-0 invert"
            width="40"
            height="40"
          />
          <span class="font-serif font-bold text-xl">{site.company_short}</span>
        </a>
        <p class="text-brand-200 text-sm leading-relaxed mb-6">
          {site.tagline}
        </p>
        <!-- Social links -->
        <div class="flex gap-3">
          {site.social.facebook && (
            <a href={site.social.facebook} target="_blank" rel="noopener noreferrer"
               class="w-9 h-9 rounded-lg bg-white/10 hover:bg-brand-500 flex items-center justify-center transition-colors"
               aria-label="Facebook">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {site.social.linkedin && (
            <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer"
               class="w-9 h-9 rounded-lg bg-white/10 hover:bg-brand-500 flex items-center justify-center transition-colors"
               aria-label="LinkedIn">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
          {site.social.youtube && (
            <a href={site.social.youtube} target="_blank" rel="noopener noreferrer"
               class="w-9 h-9 rounded-lg bg-white/10 hover:bg-brand-500 flex items-center justify-center transition-colors"
               aria-label="YouTube">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Col 2: Giải pháp -->
      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider text-brand-300 mb-4">Giải pháp</h3>
        <ul class="space-y-2 text-sm">
          {[
            ['Tự động hóa công nghiệp', 'tu-dong-hoa-cong-nghiep'],
            ['Phát triển phần mềm', 'phat-trien-phan-mem'],
            ['Thiết kế phần cứng', 'thiet-ke-phan-cung'],
            ['Hệ thống điện', 'he-thong-dien'],
            ['Hệ thống nước', 'he-thong-nuoc'],
            ['IoT & Giám sát từ xa', 'iot-giam-sat'],
          ].map(([label, slug]) => (
            <li>
              <a href={url(`/giai-phap/${slug}`)}
                 class="text-brand-200 hover:text-white transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Công ty -->
      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider text-brand-300 mb-4">Công ty</h3>
        <ul class="space-y-2 text-sm">
          {[
            ['Về Nano Power', '/gioi-thieu'],
            ['Dự án tiêu biểu', '/du-an'],
            ['Tin tức', '/tin-tuc'],
            ['Tuyển dụng', '/tuyen-dung'],
            ['Liên hệ', '/lien-he'],
          ].map(([label, href]) => (
            <li>
              <a href={url(href as string)} class="text-brand-200 hover:text-white transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Liên hệ -->
      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider text-brand-300 mb-4">Liên hệ</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex gap-2 text-brand-200">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{site.address}</span>
          </li>
          <li class="flex gap-2 text-brand-200">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${site.phone}`} class="hover:text-white transition-colors">{site.phone}</a>
          </li>
          <li class="flex gap-2 text-brand-200">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href={`mailto:${site.email}`} class="hover:text-white transition-colors">{site.email}</a>
          </li>
          <li class="flex gap-2 text-brand-200">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>{site.working_hours}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-brand-300">
      <span>© {new Date().getFullYear()} {site.company_name}. Bảo lưu mọi quyền.</span>
      <span>MST: {site.tax_code}</span>
    </div>
  </div>
</footer>
