---
import { url, formatDate, categoryLabels } from '../utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, date, cover, category } = post.data;
const slug = post.id;
---

<a
  href={url(`/tin-tuc/${slug}`)}
  class="group flex flex-col bg-white rounded-[var(--radius-card)] border border-slate-100
         hover:border-slate-200 hover:shadow-[var(--shadow-card-hover)]
         hover:-translate-y-[2px] transition-all duration-150"
>
  <!-- Cover — 4:3, no green bg -->
  <figure class="aspect-[4/3] overflow-hidden bg-slate-100 shrink-0 rounded-t-[var(--radius-card)]">
    <img
      src={cover}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
      loading="lazy"
      width="640"
      height="360"
    />
  </figure>

  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-center gap-2 mb-3">
      <span class="bg-slate-100 text-slate-600 text-[0.6875rem] font-semibold px-2.5 py-1 rounded-full">
        {categoryLabels[category] ?? category}
      </span>
      <time class="text-slate-400 text-[0.6875rem]">{formatDate(date)}</time>
    </div>

    <h3 class="font-semibold text-base text-ink group-hover:text-brand-700 transition-colors leading-snug mb-2 line-clamp-2">
      {title}
    </h3>
    <p class="text-muted text-sm leading-relaxed flex-1 line-clamp-3">
      {description}
    </p>

    <div class="mt-4 flex items-center gap-1 text-brand-700 text-sm font-medium">
      Đọc tiếp
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </div>
  </div>
</a>
