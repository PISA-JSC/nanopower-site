---
import { url, formatDate, categoryLabels } from '../utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, date, category } = post.data;
const slug = post.id;

/* Category accent colours — top strip + badge */
const catColor: Record<string, { strip: string; badge: string; text: string }> = {
  'tin-cong-ty': { strip: 'bg-brand-500',  badge: 'bg-brand-50  text-brand-700',  text: '' },
  'kien-thuc':   { strip: 'bg-blue-500',   badge: 'bg-blue-50   text-blue-700',   text: '' },
  'san-pham':    { strip: 'bg-violet-500', badge: 'bg-violet-50 text-violet-700', text: '' },
  'tuyen-dung':  { strip: 'bg-amber-500',  badge: 'bg-amber-50  text-amber-700',  text: '' },
};
const c = catColor[category] ?? catColor['kien-thuc'];
---

<a
  href={url(`/tin-tuc/${slug}`)}
  class="group flex flex-col bg-white rounded-[var(--radius-card)] border border-slate-100 overflow-hidden
         hover:border-slate-200 hover:shadow-[var(--shadow-card-hover)]
         hover:-translate-y-[2px] transition-all duration-150"
>
  <!-- 3 px category stripe — visually intentional, not a broken image -->
  <div class={`h-[3px] w-full ${c.strip} shrink-0`}></div>

  <div class="p-6 flex flex-col flex-1">
    <!-- Category badge + date -->
    <div class="flex items-center gap-2.5 mb-4">
      <span class={`text-[0.6875rem] font-semibold px-2.5 py-1 rounded-full ${c.badge}`}>
        {categoryLabels[category] ?? category}
      </span>
      <time class="text-slate-400 text-[0.6875rem]" datetime={post.data.date.toISOString()}>
        {formatDate(date)}
      </time>
    </div>

    <h3 class="font-bold text-[0.9375rem] text-ink leading-snug mb-3 line-clamp-2" style="font-weight: 800;">
      {title}
    </h3>
    <p class="text-slate-500 text-sm leading-relaxed flex-1 line-clamp-3 mb-5">
      {description}
    </p>

    <div class="flex items-center gap-1 text-xs font-bold" style="color: #1668e3;">
      Đọc bài viết
      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
</a>
