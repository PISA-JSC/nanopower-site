---
import { url } from '../utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  solution: CollectionEntry<'solutions'>;
}

const { solution } = Astro.props;
const { title, summary, icon, cover } = solution.data;
const slug = solution.id;
---

<a
  href={url(`/giai-phap/${slug}`)}
  class="group flex flex-col bg-white rounded-card border border-gray-100 overflow-hidden
         shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)]
         hover:-translate-y-1 transition-all duration-300"
>
  <!-- Cover image with fixed 16:9 ratio -->
  <figure class="aspect-[16/9] overflow-hidden bg-brand-50">
    <img
      src={cover}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
      width="640"
      height="360"
    />
  </figure>

  <div class="p-6 flex flex-col flex-1">
    <div class="flex items-center gap-3 mb-3">
      <span class="text-2xl" aria-hidden="true">{icon}</span>
      <h3 class="font-serif font-bold text-lg text-ink group-hover:text-brand-700 transition-colors leading-snug">
        {title}
      </h3>
    </div>
    <p class="text-muted text-sm leading-relaxed flex-1">{summary}</p>
    <div class="mt-5 flex items-center gap-1 text-brand-700 text-sm font-semibold">
      Xem chi tiết
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </div>
  </div>
</a>
