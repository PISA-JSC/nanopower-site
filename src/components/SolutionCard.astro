---
import { url } from '../utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  solution: CollectionEntry<'solutions'>;
}
const { solution } = Astro.props;
const { title, summary, cover } = solution.data;
const slug = solution.id;

/* SVG icon paths keyed by solution slug — stroke-based, 24×24 viewBox */
const iconPaths: Record<string, string> = {
  'tu-dong-hoa-cong-nghiep': `
    <circle cx="12" cy="12" r="3"/>
    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5.636 5.636l1.414 1.414m9.9 9.9 1.414 1.414M5.636 18.364l1.414-1.414m9.9-9.9 1.414-1.414"/>`,
  'phat-trien-phan-mem': `
    <polyline points="16 18 22 12 16 6"/>
    <polyline points="8 6 2 12 8 18"/>`,
  'thiet-ke-phan-cung': `
    <rect x="5" y="5" width="14" height="14" rx="1"/>
    <line x1="9" y1="5" x2="9" y2="3"/><line x1="15" y1="5" x2="15" y2="3"/>
    <line x1="9" y1="21" x2="9" y2="19"/><line x1="15" y1="21" x2="15" y2="19"/>
    <line x1="5" y1="9" x2="3" y2="9"/><line x1="5" y1="15" x2="3" y2="15"/>
    <line x1="21" y1="9" x2="19" y2="9"/><line x1="21" y1="15" x2="19" y2="15"/>
    <rect x="9" y="9" width="6" height="6" rx="0.5"/>`,
  'he-thong-dien': `
    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`,
  'he-thong-nuoc': `
    <path d="M12 2C6 8 4 12.5 4 15a8 8 0 0 0 16 0c0-2.5-2-7-8-13z"/>`,
  'iot-giam-sat': `
    <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
    <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
    <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
    <line x1="12" y1="20" x2="12.01" y2="20"/>`,
};

const svgPath = iconPaths[slug] ?? `<circle cx="12" cy="12" r="5"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/>`;
---

<a
  href={url(`/giai-phap/${slug}`)}
  class="group flex flex-col bg-white rounded-[var(--radius-card)] border border-slate-100 overflow-hidden
         hover:border-brand-200/60 hover:shadow-[var(--shadow-card-hover)]
         hover:-translate-y-[2px] transition-all duration-200"
>
  <!-- Cover image — 16:9 -->
  <figure class="aspect-[16/9] overflow-hidden shrink-0 bg-slate-100">
    <img
      src={cover}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-500"
      loading="lazy"
      width="640"
      height="360"
    />
  </figure>

  <!-- Content -->
  <div class="flex flex-col gap-4 p-5">
    <div class="flex items-center gap-3">
      <!-- SVG icon in brand pill -->
      <div class="w-9 h-9 rounded-lg bg-brand-50 group-hover:bg-brand-100/80 flex items-center justify-center transition-colors duration-150 shrink-0">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4 text-brand-700"
          set:html={svgPath}
        />
      </div>
      <h3 class="font-semibold text-[0.9375rem] text-ink group-hover:text-brand-700 transition-colors duration-150 leading-snug line-clamp-2">
        {title}
      </h3>
    </div>

    <p class="text-slate-500 text-sm leading-relaxed line-clamp-2 flex-1">
      {summary}
    </p>

    <div class="flex items-center gap-1 text-brand-700 text-xs font-semibold">
      Xem chi tiết
      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
</a>
