---
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { url, formatDate, categoryLabels } from '../utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, date, cover, category, author } = post.data;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": cover,
  "datePublished": date.toISOString(),
  "author": {
    "@type": "Organization",
    "name": author,
  },
  "publisher": {
    "@type": "Organization",
    "name": "Nano Power",
  },
};
---

<Base
  title={title}
  description={description}
  ogImage={url(cover)}
  jsonLd={jsonLd}
>
  <div style="background: #050d1c; padding-top: 80px; border-bottom: 1px solid rgba(255,255,255,0.07);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-4" style="color: rgba(220,235,255,0.55);">
      <Breadcrumb
        items={[
          { label: 'Trang chủ', href: url('/') },
          { label: 'Tin tức', href: url('/tin-tuc') },
          { label: title },
        ]}
      />
    </div>
  </div>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-white text-xs font-bold px-3 py-1 rounded-full" style="background: linear-gradient(120deg, #1668e3, #00d4ff); color: #04121f;">
          {categoryLabels[category] ?? category}
        </span>
        <time class="text-muted text-sm">{formatDate(date)}</time>
        <span class="text-muted text-sm">• {author}</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-ink leading-tight mb-4">
        {title}
      </h1>
      <p class="text-muted text-lg leading-relaxed">{description}</p>
    </header>

    <!-- Cover image -->
    <figure class="mb-10 rounded-card overflow-hidden">
      <img
        src={url(cover)}
        alt={title}
        class="w-full aspect-[1200/630] object-cover"
        loading="eager"
        width="1200"
        height="630"
      />
    </figure>

    <!-- Content -->
    <div class="prose">
      <slot />
    </div>

    <!-- Share -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <ShareButtons title={title} />
    </div>
  </article>
</Base>
