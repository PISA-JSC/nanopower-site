---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { loadYaml, type SiteData } from '../utils/data';
import { url } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  jsonLd?: object;
}

const site = loadYaml<SiteData>('site.yml');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title,
  description = site.tagline,
  ogImage = `${base}/images/covers/og-default.svg`,
  canonical,
  jsonLd,
} = Astro.props;

const fullTitle = title === site.company_short
  ? `${site.company_short} — ${site.tagline}`
  : `${title} | ${site.company_short}`;

const canonicalUrl = canonical ?? Astro.url.href;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="vi_VN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    <!-- JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Organization JSON-LD (all pages) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": site.company_name,
      "url": `https://phamduckhanh.github.io/nanopower-site`,
      "logo": `https://phamduckhanh.github.io/nanopower-site/favicon.svg`,
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": site.phone,
        "contactType": "customer service",
        "availableLanguage": "Vietnamese"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": site.address,
        "addressCountry": "VN"
      }
    })} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
